{
  "name": "seepferdchen-aquarium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive aquarium for a five-year-old, in the world of the Seepferdchenhof books",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/graph.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "graph": "node scripts/graph.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.2.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
